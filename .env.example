STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Calendar / video
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
DAILY_API_KEY=

# Email
RESEND_API_KEY=

# AI
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# Jobs / analytics / monitoring
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
